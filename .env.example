# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Slack Configuration
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_CHANNEL_ID=your-channel-id  # #test-noti

# Milvus Configuration
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=paper_embeddings

# Embedding Configuration
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# LLM Configuration
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000

# Rate Limiting Configuration
OPENAI_MAX_CONCURRENT_REQUESTS=5  # Maximum concurrent OpenAI API calls

# Paper Collection Configuration
PAPERS_FETCH_LIMIT=30
PAPERS_FETCH_SCHEDULE="0 9 * * 1"  # Every Monday at 09:00

# Recommendation Configuration
TOP_K_RECOMMENDATIONS=3
MIN_SIMILARITY_SCORE=0.1
AUTO_RECOMMEND_ENABLED=false       # Enable automatic scheduled recommendations
AUTO_RECOMMEND_INTERVAL_HOURS=24.0 # Interval between auto recommendations

# Application Configuration
LOG_LEVEL=INFO
ENVIRONMENT=development

# CORS Configuration (comma-separated list, use '*' for development only)
CORS_ALLOWED_ORIGINS=*
# Production example: CORS_ALLOWED_ORIGINS=https://your-domain.com,https://app.your-domain.com

# collection settings
collection_interval_hours=24.0  # 수집 주기 (시간)
paper_collection_limit=30       # 수집할 논문 수